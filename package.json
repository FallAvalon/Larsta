{
  "name": "larsta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.server.json && node --watch dist-server/server/index.js --dev",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "test:ui": "node scripts/test-ui.mjs",
    "check": "tsc --noEmit",
    "backup": "node dist-server/server/backup-cli.js",
    "public:check": "node scripts/publication.mjs --workspace",
    "public:prepare": "node scripts/prepare-public.mjs"
  },
  "dependencies": {
    "eventsource-parser": "^3.0.6",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
