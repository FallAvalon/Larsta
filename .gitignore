# Publication allowlist. Everything else stays local by default.
*
!*/
!/.gitignore
!/.gitattributes
!/README.md
!/README.ru.md
!/SECURITY.md
!/index.html
!/package.json
!/package-lock.json
!/start.cmd
!/start.sh
!/tsconfig.json
!/tsconfig.server.json
!/tsconfig.test.json
!/vite.config.ts
!/src/**/*.ts
!/src/**/*.tsx
!/src/**/*.css
!/server/**/*.ts
!/shared/**/*.ts
!/tests/**/*.ts
!/tests/**/*.mjs
!/scripts/**/*.mjs
!/public/favicon.svg
!/examples/character-v2.json

# Runtime data and local artifacts are never public, at any depth.
**/data/
**/uploads/
**/backups/
**/before-restore*/
**/node_modules/
**/dist/
**/dist-server/
**/.test-build/
**/test-results/
**/.codex/
**/.agents/
**/.aws/
**/.env*
**/server-secrets*
**/*.sqlite*
**/*.db
**/*.log
**/*.key
**/*.pem
**/*.zip
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp
**/*.gif
**/REPORT.md
/scripts/extract-i18n.mjs
